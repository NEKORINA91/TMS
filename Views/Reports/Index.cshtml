@model FinanceReport
@{
    ViewData["Title"] = "Financial Report";
    var today = DateTime.Today;
    var monthStart = new DateTime(today.Year, today.Month, 1);
    string fromStr = Model.From.ToString("yyyy-MM-dd");
    string toStr = Model.To.ToString("yyyy-MM-dd");
    string todayStr = today.ToString("yyyy-MM-dd");
    string thisMonth = monthStart.ToString("yyyy-MM-dd");
    string lastFrom = monthStart.AddMonths(-1).ToString("yyyy-MM-dd");
    string lastTo = monthStart.AddDays(-1).ToString("yyyy-MM-dd");
    string yearFrom = new DateTime(today.Year, 1, 1).ToString("yyyy-MM-dd");
}
<style>
    @@media print {
        .no-print {
            display: none !important;
        }
    }</style>

    <h2 class="mb-1">Financial Report</h2>
    <p class="text-muted">@Model.From.ToString("dd MMM yyyy") to @Model.To.ToString("dd MMM yyyy")</p>

    <form method="get" asp-action="Index" class="row g-2 mb-2 no-print">
        <div class="col-auto"><input type="date" name="from" value="@fromStr" class="form-control" /></div>
        <div class="col-auto"><input type="date" name="to" value="@toStr" class="form-control" /></div>
        <div class="col-auto"><button type="submit" class="btn btn-primary">Show</button></div>
    </form>

    <div class="mb-3 no-print">
        <a asp-action="Index" asp-route-from="@thisMonth" asp-route-to="@todayStr" class="btn btn-sm btn-outline-secondary">This month</a>
        <a asp-action="Index" asp-route-from="@lastFrom" asp-route-to="@lastTo" class="btn btn-sm btn-outline-secondary">Last month</a>
        <a asp-action="Index" asp-route-from="@yearFrom" asp-route-to="@todayStr" class="btn btn-sm btn-outline-secondary">This year</a>
        <a asp-action="ExportCsv" asp-route-from="@fromStr" asp-route-to="@toStr" class="btn btn-sm btn-outline-success">Export CSV</a>
        <button type="button" onclick="window.print()" class="btn btn-sm btn-outline-dark">Print / Save as PDF</button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card p-3"><small class="text-muted">Fee income</small><h4>Rs. @Model.TotalIncome.ToString("N2")</h4></div></div>
        <div class="col-md-3"><div class="card p-3"><small class="text-muted">Teacher payouts paid</small><h4>Rs. @Model.Payouts.ToString("N2")</h4></div></div>
        <div class="col-md-3"><div class="card p-3"><small class="text-muted">Expenses</small><h4>Rs. @Model.TotalExpenses.ToString("N2")</h4></div></div>
        <div class="col-md-3"><div class="card p-3"><small class="text-muted">Balance</small><h4>Rs. @Model.Balance.ToString("N2")</h4></div></div>
    </div>

    <h5>Fee income by class</h5>
    <table class="table table-sm mb-4">
        <thead><tr><th>Class</th><th>Payments</th><th>Total</th></tr></thead>
        <tbody>
            @foreach (var l in Model.Income)
            {
                <tr><td>@l.Label</td><td>@l.Count</td><td>Rs. @l.Total.ToString("N2")</td></tr>
            }
            @if (!Model.Income.Any())
            {
                <tr><td colspan="3" class="text-muted">No payments in this range.</td></tr>
            }
        </tbody>
    </table>

    <h5>Expenses by category</h5>
    <table class="table table-sm">
        <thead><tr><th>Category</th><th>Entries</th><th>Total</th></tr></thead>
        <tbody>
            @foreach (var l in Model.Expenses)
            {
                <tr><td>@l.Label</td><td>@l.Count</td><td>Rs. @l.Total.ToString("N2")</td></tr>
            }
            @if (!Model.Expenses.Any())
            {
                <tr><td colspan="3" class="text-muted">No expenses in this range.</td></tr>
            }
        </tbody>
    </table>