@{
    ViewData["Title"] = "Add Class";
}
<h2>Add Class</h2>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label>Class name</label><input name="className" class="form-control" required /></div>
    <div class="mb-3">
        <label>Subject</label>
        <select name="subjectId" class="form-select" required>
            <option value="">-- Select --</option>
            @foreach (var s in ViewBag.Subjects)
            {
                <option value="@s.SubjectId">@s.SubjectName @s.Level</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label>Teacher</label>
        <select name="teacherId" class="form-select" required>
            <option value="">-- Select --</option>
            @foreach (var t in ViewBag.Teachers)
            {
                <option value="@t.TeacherId">@t.FullName</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label>Day</label>
        <select name="dayOfWeek" class="form-select">
            <option>Monday</option>
            <option>Tuesday</option>
            <option>Wednesday</option>
            <option>Thursday</option>
            <option>Friday</option>
            <option>Saturday</option>
            <option>Sunday</option>
        </select>
    </div>
    <div class="row">
        <div class="col mb-3"><label>Start</label><input name="startTime" type="time" class="form-control" required /></div>
        <div class="col mb-3"><label>End</label><input name="endTime" type="time" class="form-control" required /></div>
    </div>
    <div class="mb-3"><label>Room</label><input name="room" class="form-control" maxlength="50" /></div>
    <div class="mb-3"><label>Monthly fee (Rs.)</label><input name="monthlyFee" type="number" step="0.01" min="0" class="form-control" required /></div>
    <div class="mb-3"><label>Max capacity</label><input name="maxCapacity" type="number" min="1" value="50" class="form-control" required /></div>
    <button class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>