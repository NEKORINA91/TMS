@model List<TMS.Models.Domain.Class>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<h2>Classes</h2>
<a asp-action="Create" class="btn btn-primary mb-3">+ Add Class</a>

<input class="form-control mb-3" style="max-width:320px" placeholder="Search..." data-filter-table="listTable" />

<table class="table table-striped" id="listTable">
    <thead>
        <tr>
            <th>Class</th>
            <th>Subject</th>
            <th>Teacher</th>
            <th>Day / Time</th>
            <th>Room</th>
            <th>Fee</th>
            <th>Enrolled</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.ClassName</td>
                <td>@c.Subject?.SubjectName @c.Subject?.Level</td>
                <td>@c.Teacher?.User?.FullName</td>
                <td>@c.DayOfWeek @c.StartTime.ToString(@"hh\:mm")–@c.EndTime.ToString(@"hh\:mm")</td>
                <td>@c.Room</td>
                <td>Rs. @c.MonthlyFee.ToString("N2")</td>
                <td>@c.Enrollments.Count(e => e.IsActive) / @c.MaxCapacity</td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@c.ClassId" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@c.ClassId" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this class?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>