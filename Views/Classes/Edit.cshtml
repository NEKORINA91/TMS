@model TMS.Models.Domain.Class
@{
    ViewData["Title"] = "Edit Class";
    var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
    var st = Model.StartTime.ToString(@"hh\:mm");
    var et = Model.EndTime.ToString(@"hh\:mm");
    var fee = Model.MonthlyFee.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
}
<h2>Edit Class</h2>

<form asp-action="Edit" asp-route-id="@Model.ClassId" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label>Class name</label><input name="className" class="form-control" value="@Model.ClassName" required /></div>
    <div class="mb-3">
        <label>Subject</label>
        <select name="subjectId" class="form-select" required>
            @foreach (var s in ViewBag.Subjects)
            {
                <option value="@s.SubjectId" selected="@((int)s.SubjectId == Model.SubjectId)">@s.SubjectName @s.Level</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label>Teacher</label>
        <select name="teacherId" class="form-select" required>
            @foreach (var t in ViewBag.Teachers)
            {
                <option value="@t.TeacherId" selected="@((int)t.TeacherId == Model.TeacherId)">@t.FullName</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label>Day</label>
        <select name="dayOfWeek" class="form-select">
            @foreach (var d in days)
            {
                <option selected="@(Model.DayOfWeek == d)">@d</option>
            }
        </select>
    </div>
    <div class="row">
        <div class="col mb-3"><label>Start</label><input name="startTime" type="time" class="form-control" value="@st" required /></div>
        <div class="col mb-3"><label>End</label><input name="endTime" type="time" class="form-control" value="@et" required /></div>
    </div>
    <div class="mb-3"><label>Room</label><input name="room" class="form-control" maxlength="50" value="@Model.Room" /></div>
    <div class="mb-3"><label>Monthly fee (Rs.)</label><input name="monthlyFee" type="number" step="0.01" min="0" class="form-control" value="@fee" required /></div>
    <div class="mb-3"><label>Max capacity</label><input name="maxCapacity" type="number" min="1" class="form-control" value="@Model.MaxCapacity" required /></div>
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="isActive" value="true" checked="@Model.IsActive" />
        <input type="hidden" name="isActive" value="false" />
        <label class="form-check-label">Active</label>
    </div>
    <button class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>