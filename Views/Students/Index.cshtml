@model List<TMS.Models.Domain.Student>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<h2>Students</h2>
<a asp-action="Create" class="btn btn-primary mb-3">+ Add Student</a>

<input class="form-control mb-3" style="max-width:320px" placeholder="Search..." data-filter-table="listTable" />


<table class="table table-striped" id="listTable">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Guardian Phone</th>
            <th>Enrolled</th>
            <th>Active</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.User.SystemId</td>
                <td>@s.User.FullName</td>
                <td>@s.User.Email</td>
                <td>@s.GuardianPhone</td>
                <td>@s.EnrolledAt.ToString("dd MMM yyyy")</td>
                <td>@(s.User.IsActive ? "Yes" : "No")</td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@s.StudentId" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@s.StudentId" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this student?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>