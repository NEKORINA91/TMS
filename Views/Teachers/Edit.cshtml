@using System.Globalization
@model TMS.Models.Domain.Teacher
@{
    ViewData["Title"] = "Edit Teacher";
    var rate = Model.CommissionRate.ToString("0.##", CultureInfo.InvariantCulture);
    bool weekly = Model.PayoutFrequency == "Weekly";
}
<h2>Edit @Model.User.FullName (@Model.User.SystemId)</h2>

<form asp-action="Edit" asp-route-id="@Model.TeacherId" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label>Full name</label><input name="fullName" class="form-control" value="@Model.User.FullName" required /></div>
    <div class="mb-3"><label>Email</label><input name="email" type="email" class="form-control" value="@Model.User.Email" required /></div>
    <div class="mb-3"><label>Qualifications</label><input name="qualifications" class="form-control" maxlength="200" value="@Model.Qualifications" /></div>
    <div class="mb-3"><label>Short bio</label><input name="shortBio" class="form-control" maxlength="500" value="@Model.ShortBio" /></div>
    <div class="mb-3"><label>Contact number</label><input name="contactNumber" class="form-control" maxlength="20" value="@Model.ContactNumber" /></div>
    <div class="mb-3">
        <label>Centre commission (%): the share of fees the centre keeps</label>
        <input name="commissionRate" type="number" step="0.01" min="0" max="100" class="form-control" value="@rate" required />
    </div>
    <div class="mb-3">
        <label>Payout frequency</label>
        <select name="payoutFrequency" class="form-select">
            <option selected="@(!weekly)">Monthly</option>
            <option selected="@weekly">Weekly</option>
        </select>
    </div>
    <div class="mb-3"><label>Bank account</label><input name="bankAccount" class="form-control" maxlength="100" value="@Model.BankAccount" /></div>
    <div class="mb-3"><label>New password (leave empty to keep the current one)</label><input name="newPassword" type="password" class="form-control" /></div>
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="isActive" value="true" checked="@Model.User.IsActive" />
        <input type="hidden" name="isActive" value="false" />
        <label class="form-check-label">Active (can log in)</label>
    </div>
    <button class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>