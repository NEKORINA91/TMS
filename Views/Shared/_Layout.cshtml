@using TMS.Helpers
@{
    var sessionUser = Context.Session.GetSessionUser();
    bool isAdmin = sessionUser != null && (sessionUser.Role == "Admin" || sessionUser.Role == "SuperAdmin");
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();

    // (controller name, label, icon) - add a new line here for each new page
    var links = new[]
    {
        ("AdminDashboard", "Dashboard"),
        ("Students",       "Students"),
        ("Teachers",       "Teachers"),
        ("Classes",        "Classes"),
        ("FeeCollections", "Fee Collections"),
        ("Expenses",       "Expenses"),
        ("Enrollments",    "Enrollments"),
        ("Payouts",        "Payouts"),
        ("Reports",        "Reports"),
        ("Financials",        "Financials"),
        ("Attendance",     "Attendance"),
        ("Calendar",       "Calendar")
    };

    string initials = "";
    if (sessionUser != null)
    {
        var parts = sessionUser.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = string.Concat(parts.Take(2).Select(p => char.ToUpper(p[0])));
    }

}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TMS</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TMS.styles.css" asp-append-version="true" />
</head>
<body>
    @if (isAdmin)
    {
        <div class="d-flex">

            <!-- Sidebar: fixed on desktop, slide-out on phones -->
            <div class="offcanvas-lg offcanvas-start border-end bg-white sidebar" tabindex="-1" id="sidebar"
                 style="--bs-offcanvas-width: 260px;">
                <div class="offcanvas-header d-lg-none">
                    <h5 class="offcanvas-title">TMS</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebar"></button>
                </div>
                <div class="offcanvas-body d-flex flex-column p-3">
                    <div class="d-none d-lg-block mb-3">
                        <div class="fw-bold fs-5">TMS</div>
                        <div class="text-muted small">Admin Suite</div>
                    </div>

                    <ul class="nav nav-pills flex-column gap-1">
                        @foreach (var (c, label) in links)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ctrl == c ? "active" : "")" asp-controller="@c" asp-action="Index">@label</a>
                            </li>
                        }
                        @if (sessionUser.Role == "SuperAdmin")
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ctrl == "Admins" ? "active" : "")" asp-controller="Admins" asp-action="Index">🛡️&nbsp; Admin Accounts</a>
                            </li>
                        }
                    </ul>

                    
                </div>
            </div>

            <!-- Page area -->
            <div class="flex-grow-1 main-area">
                <nav class="navbar bg-white border-bottom px-3">
                    <div class="d-flex align-items-center">
                        <button class="btn btn-outline-secondary d-lg-none me-2" type="button"
                                data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-label="Menu">
                            ☰
                        </button>
                        <span class="navbar-brand mb-0 d-lg-none">TMS</span>
                    </div>

                    <div class="dropdown ms-auto">
                        <button class="avatar-btn" type="button" data-bs-toggle="dropdown"
                                aria-expanded="false" title="@sessionUser.FullName">
                            @initials
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li class="px-3 py-2">
                                <div class="fw-semibold">@sessionUser.FullName</div>
                                <div class="small text-muted">@sessionUser.Role · @sessionUser.SystemId</div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="px-3 pb-1">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Sign out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </nav>
                <main role="main" class="p-3 p-lg-4">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <nav class="navbar bg-white border-bottom mb-3 px-3">
            <a class="navbar-brand" href="/">TMS</a>
            @if (sessionUser != null)
            {
                <form asp-controller="Auth" asp-action="Logout" method="post" class="d-flex align-items-center gap-2">
                    <span class="text-muted small">@sessionUser.FullName (@sessionUser.Role)</span>
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Sign out</button>
                </form>
            }
        </nav>
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>