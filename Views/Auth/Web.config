<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    ════════════════════════════════════════════════════════════
     CONNECTION STRING
     Replace (local) with your SQL Server instance name if needed.
     e.g. DESKTOP-ABC123\SQLEXPRESS  or  .\SQLEXPRESS
    ════════════════════════════════════════════════════════════
  -->
  <connectionStrings>
    <add name="TuitionProDB"
         connectionString="Data Source=ABDULLAH\SQLEXPRESS;Initial Catalog=TuitionProDB;Integrated Security=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />

    <!-- Session timeout: 60 minutes -->
    <sessionState timeout="60" />
  </system.web>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>

  <!--
    ════════════════════════════════════════════════════════════
     EF6 - Disable automatic migrations (we manage schema via SQL)
    ════════════════════════════════════════════════════════════
  -->
  <entityFramework>
    <contexts>
      <context type="TuitionPro.DAL.TuitionProContext, TuitionPro"
               disableDatabaseInitialization="true" />
    </contexts>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="mssqllocaldb" />
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <provider invariantName="System.Data.SqlClient"
                type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>

</configuration>
