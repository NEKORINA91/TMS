
@{
    ViewData["Title"] = "Record Fee Collection";
    var students = ViewBag.Students;
    var classes = ViewBag.Classes;
}

<h2>Record Fee Collection</h2>
<div asp-validation-summary="All" class="text-danger mb-2"></div>
<form asp-action="Create" method="post">
    <div class="mb-3">
        <label>Student</label>
        <select name="studentId" class="form-select" required>
            <option value="">-- Select Student --</option>
            @foreach (var s in students)
            {
                <option value="@s.StudentId">@s.FullName</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>Class</label>
        <select name="classId" class="form-select" required>
            <option value="">-- Select Class --</option>
            @foreach (var c in classes)
            {
                <option value="@c.ClassId">@c.ClassName (Rs. @c.MonthlyFee)</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>Amount (Rs.)</label>
        <input type="number" step="0.01" min="0.01" name="amount" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Payment Period (Month)</label>
        <input type="month" name="periodMonth" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">Record Payment</button>
</form>

@section Scripts {
    <script>
        const p = new URLSearchParams(location.search);
        const set = (name, key) => {
            const el = document.querySelector('[name=' + name + ']');
            if (el && p.get(key)) el.value = p.get(key);
        };
        set('studentId', 'studentId');
        set('classId', 'classId');
        set('amount', 'amount');
        set('periodMonth', 'month');
    </script>
}