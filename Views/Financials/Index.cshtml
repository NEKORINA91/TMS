@{
    ViewData["Title"] = "Financials";
    var categories = (string[])ViewBag.Categories;
    var thisMonth = DateTime.Today.ToString("yyyy-MM");
}
<style>
    @@media print {
        .no-print {
            display: none !important;
        }
    }</style>

    <form id="tokenForm">@Html.AntiForgeryToken()</form>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <div>
            <h2 class="mb-0">@Institute.Name: Financial Report Hub</h2>
            <div class="text-muted" id="subtitle"></div>
        </div>
        <div class="ms-auto d-flex gap-2 no-print">
            <input type="month" id="month" class="form-control" value="@thisMonth" />
            <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-primary">Detailed report</a>
            <button type="button" class="btn btn-outline-dark" onclick="window.print()">Print / PDF</button>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-lg"><div class="card p-3"><small class="text-muted">Collected today</small><h5 id="todayRev" class="mb-0">-</h5></div></div>
        <div class="col-6 col-lg"><div class="card p-3"><small class="text-muted">Expenses today</small><h5 id="todayExp" class="mb-0">-</h5></div></div>
        <div class="col-6 col-lg"><div class="card p-3"><small class="text-muted">Collected this month</small><h5 id="monthRev" class="mb-0">-</h5></div></div>
        <div class="col-6 col-lg"><div class="card p-3"><small class="text-muted">Expenses this month</small><h5 id="monthExp" class="mb-0">-</h5></div></div>
        <div class="col-12 col-lg"><div class="card p-3"><small class="text-muted">Net (fees - expenses)</small><h5 id="net" class="mb-0">-</h5></div></div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-4"><div class="card p-3 border-success"><small class="text-muted">Paid this month</small><h5 id="paidCount" class="mb-0">-</h5><div class="text-muted small" id="paidAmt"></div></div></div>
        <div class="col-md-4"><div class="card p-3 border-warning"><small class="text-muted">Pending (unpaid this month)</small><h5 id="pendCount" class="mb-0">-</h5><div class="text-muted small" id="pendAmt"></div></div></div>
        <div class="col-md-4"><div class="card p-3 border-danger"><small class="text-muted">Overdue (unpaid last month)</small><h5 id="overCount" class="mb-0">-</h5><div class="text-muted small" id="overAmt"></div></div></div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-8">
            <div class="card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Revenue vs Expenses</h5>
                    <a asp-controller="FeeCollections" asp-action="Due">Fees due &rarr;</a>
                </div>
                <canvas id="chart" height="120"></canvas>
            </div>
        </div>
        <div class="col-lg-4 no-print">
            <div class="card p-3 h-100">
                <h5>Log Expense</h5>
                <form id="expForm" enctype="multipart/form-data">
                    <div class="mb-2"><label class="form-label">Description</label><input name="description" class="form-control" maxlength="300" placeholder="e.g. Utility bill - electricity" required /></div>
                    <div class="mb-2"><label class="form-label">Amount (Rs.)</label><input name="amount" type="number" step="0.01" min="0.01" class="form-control" required /></div>
                    <div class="mb-2">
                        <label class="form-label">Category</label>
                        <select name="category" class="form-select">
                            @foreach (var c in categories)
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2"><label class="form-label">Receipt (PDF, JPG, PNG, max 5 MB)</label><input name="receipt" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" /></div>
                    <button class="btn btn-primary w-100">Save Expense</button>
                    <div id="expMsg" class="small mt-2"></div>
                </form>
            </div>
        </div>
    </div>

    <div class="card p-3 mb-3">
        <h5>Recent fee collections</h5>
        <table class="table table-sm mb-0">
            <thead><tr><th>Receipt</th><th>Student</th><th>Class</th><th>Date</th><th>Status</th><th class="text-end">Amount</th></tr></thead>
            <tbody id="feeBody"></tbody>
        </table>
    </div>

    <div class="card p-3 mb-3">
        <h5>Recent expenses</h5>
        <table class="table table-sm mb-0">
            <thead><tr><th>Date</th><th>Description</th><th>Category</th><th>Receipt</th><th class="text-end">Amount</th><th class="no-print"></th></tr></thead>
            <tbody id="expBody"></tbody>
        </table>
    </div>

    <div class="card p-3 mb-3">
        <h5>Teacher payouts (estimate)</h5>
        <table class="table table-sm mb-0">
            <thead><tr><th>Teacher</th><th class="text-end">Fees collected</th><th class="text-end">Centre rate</th><th class="text-end">Teacher payout</th></tr></thead>
            <tbody id="payBody"></tbody>
        </table>
    </div>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script>
            const $ = id => document.getElementById(id);
            const token = document.querySelector('#tokenForm input[name="__RequestVerificationToken"]').value;
            const money = n => 'Rs. ' + Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            let chart;

            function cell(tr, text, cls) {
            const td = document.createElement('td');
            td.textContent = text;
            if (cls) td.className = cls;
            tr.appendChild(td);
            return td;
            }
            function fill(id, rows, build, emptyText, cols) {
            const tb = $(id);
            tb.replaceChildren();
            if (!rows.length) {
            const tr = document.createElement('tr');
            const td = document.createElement('td');
            td.colSpan = cols; td.className = 'text-muted'; td.textContent = emptyText;
            tr.appendChild(td); tb.appendChild(tr);
            return;
            }
            rows.forEach(r => tb.appendChild(build(r)));
            }

            async function load() {
            const res = await fetch('@Url.Action("Summary", "Financials")?month=' + $('month').value);
            const d = await res.json();

            $('subtitle').textContent = 'Overview of revenue, expenses and payouts for ' + d.monthLabel;
            $('todayRev').textContent = money(d.todayRev);
            $('todayExp').textContent = money(d.todayExp);
            $('monthRev').textContent = money(d.monthRev);
            $('monthExp').textContent = money(d.monthExp);
            $('net').textContent = money(d.monthRev - d.monthExp);

            $('paidCount').textContent = d.paidCount + ' enrolments';
            $('paidAmt').textContent = money(d.paidAmt) + ' received for this month';
            $('pendCount').textContent = d.pendingCount + ' enrolments';
            $('pendAmt').textContent = money(d.pendingAmt) + ' still to collect';
            $('overCount').textContent = d.overdueCount + ' enrolments';
            $('overAmt').textContent = money(d.overdueAmt) + ' from last month';

            if (!chart) {
            chart = new Chart($('chart'), {
            type: 'bar',
            data: { labels: [], datasets: [
            { label: 'Revenue', data: [], backgroundColor: '#4f46e5' },
            { label: 'Expenses', data: [], backgroundColor: '#cbd5e1' }
            ] },
            options: { responsive: true, scales: { y: { beginAtZero: true } } }
            });
            }
            chart.data.labels = d.labels;
            chart.data.datasets[0].data = d.rev;
            chart.data.datasets[1].data = d.exp;
            chart.update();

            fill('feeBody', d.fees, f => {
            const tr = document.createElement('tr');
            cell(tr, f.receiptNo); cell(tr, f.student); cell(tr, f.cls);
            cell(tr, new Date(f.paidAt).toLocaleString());
            cell(tr, f.status); cell(tr, money(f.amount), 'text-end');
            return tr;
            }, 'No fee payments in this month.', 6);

            fill('expBody', d.expenses, e => {
            const tr = document.createElement('tr');
            cell(tr, new Date(e.loggedAt).toLocaleDateString());
            cell(tr, e.description); cell(tr, e.category);
            const rc = cell(tr, '');
            if (e.receiptPath) {
            const a = document.createElement('a');
            a.href = e.receiptPath; a.target = '_blank'; a.textContent = 'View';
            rc.appendChild(a);
            }
            cell(tr, money(e.amount), 'text-end');
            const act = cell(tr, '', 'no-print');
            const edit = document.createElement('a');
            edit.href = '@Url.Action("Edit", "Expenses")/' + e.expenseId;
            edit.className = 'btn btn-sm btn-outline-secondary';
            edit.textContent = 'Edit';
            act.appendChild(edit);
            return tr;
            }, 'No expenses in this month.', 6);

            fill('payBody', d.payouts, p => {
            const tr = document.createElement('tr');
            cell(tr, p.name); cell(tr, money(p.gross), 'text-end');
            cell(tr, Number(p.rate) + '%', 'text-end'); cell(tr, money(p.net), 'text-end fw-bold');
            return tr;
            }, 'No paid fees for this month.', 4);
            }

            $('month').addEventListener('change', load);

            $('expForm').addEventListener('submit', async e => {
            e.preventDefault();
            const res = await fetch('@Url.Action("AddExpense", "Financials")', {
            method: 'POST',
            headers: { 'RequestVerificationToken': token },
            body: new FormData(e.target)
            });
            const d = await res.json();
            $('expMsg').className = 'small mt-2 ' + (d.ok ? 'text-success' : 'text-danger');
            $('expMsg').textContent = d.message;
            if (d.ok) { e.target.reset(); load(); }
            });

            load();
        </script>
    }