@model List<TMS.Models.Domain.Expense>

<h2>Expenses</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<a asp-action="Create" class="btn btn-primary mb-3">+ Log New Expense</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Description</th>
            <th>Category</th>
            <th>Amount</th>
            <th>Logged By</th>
            <th>Receipt</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.LoggedAt.ToString("dd MMM yyyy")</td>
                <td>@e.Description</td>
                <td>@e.Category</td>
                <td>Rs. @e.Amount.ToString("N2")</td>
                <td>@e.Admin?.User?.FullName</td>
                <td>
                    @if (!string.IsNullOrEmpty(e.ReceiptPath))
                    {
                        <a href="@e.ReceiptPath" target="_blank">View</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>