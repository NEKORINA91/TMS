@model TMS.Models.Domain.Expense
@{
    ViewData["Title"] = "Edit Expense";
    var categories = (string[])ViewBag.Categories;
    var amt = Model.Amount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
}
<h2>Edit Expense</h2>
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="Edit" asp-route-id="@Model.ExpenseId" method="post" enctype="multipart/form-data">
    <div class="mb-3"><label>Description</label><input name="description" maxlength="300" class="form-control" value="@Model.Description" required /></div>
    <div class="mb-3"><label>Amount (Rs.)</label><input name="amount" type="number" step="0.01" class="form-control" value="@amt" required /></div>
    <div class="mb-3">
        <label>Category</label>
        <select name="category" class="form-select" required>
            @foreach (var c in categories)
            {
                <option value="@c" selected="@(Model.Category == c)">@c</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label>Receipt</label>
        @if (!string.IsNullOrEmpty(Model.ReceiptPath))
        {
            <div class="mb-1"><a href="@Model.ReceiptPath" target="_blank">View current receipt</a></div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="removeReceipt" value="true" />
                <input type="hidden" name="removeReceipt" value="false" />
                <label class="form-check-label">Remove current receipt</label>
            </div>
        }
        <input type="file" name="receipt" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
        <div class="form-text">Choose a file only if you want to replace the receipt.</div>
    </div>
    <button class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>