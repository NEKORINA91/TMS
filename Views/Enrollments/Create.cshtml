@{
    ViewData["Title"] = "Enroll Student";
    var students = ViewBag.Students;
    var classes = ViewBag.Classes;
}
<h2>Enroll Student</h2>
<div asp-validation-summary="All" class="text-danger mb-2"></div>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label>Student</label>
        <select name="studentId" class="form-select" required>
            <option value="">-- Select Student --</option>
            @foreach (var s in students)
            {
                <option value="@s.StudentId">@s.FullName</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>Class</label>
        <select name="classId" class="form-select" required>
            <option value="">-- Select Class --</option>
            @foreach (var c in classes)
            {
                <option value="@c.ClassId">@c.ClassName (@c.Enrolled / @c.MaxCapacity)</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Enroll</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>