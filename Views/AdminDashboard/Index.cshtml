@{
    ViewData["Title"] = "Admin Dashboard";
    var recent = (List<TMS.Models.Domain.FeeCollection>)ViewBag.RecentFees;
}

<h2 class="mb-3">Admin Dashboard</h2>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card p-3"><small class="text-muted">Students</small><h3>@ViewBag.StudentCount</h3></div></div>
    <div class="col-md-3"><div class="card p-3"><small class="text-muted">Teachers</small><h3>@ViewBag.TeacherCount</h3></div></div>
    <div class="col-md-3"><div class="card p-3"><small class="text-muted">Active classes</small><h3>@ViewBag.ClassCount</h3></div></div>
    <div class="col-md-3"><div class="card p-3"><small class="text-muted">Pending fees</small><h3>@ViewBag.PendingFees</h3></div></div>
    <div class="col-md-6"><div class="card p-3"><small class="text-muted">Revenue this month</small><h3>Rs. @(((decimal)ViewBag.MonthRevenue).ToString("N2"))</h3></div></div>
    <div class="col-md-6"><div class="card p-3"><small class="text-muted">Expenses this month</small><h3>Rs. @(((decimal)ViewBag.MonthExpenses).ToString("N2"))</h3></div></div>
</div>

<div class="mb-4">
    <a asp-controller="FeeCollections" asp-action="Create" class="btn btn-primary">Record Fee</a>
    <a asp-controller="Expenses" asp-action="Create" class="btn btn-outline-primary">Log Expense</a>
</div>

<h5>Recent payments</h5>
<table class="table table-sm">
    <thead><tr><th>Receipt</th><th>Student</th><th>Class</th><th>Amount</th><th>Status</th></tr></thead>
    <tbody>
        @foreach (var f in recent)
        {
            <tr>
                <td>@f.ReceiptNo</td>
                <td>@f.Student?.User?.FullName</td>
                <td>@f.Class?.ClassName</td>
                <td>Rs. @f.Amount.ToString("N2")</td>
                <td>@f.Status</td>
            </tr>
        }
    </tbody>
</table>